{
  "name": "portfolio-website",
  "homepage": "https://singhcerely.tech",
  "version": "2.0.0",
  "private": true,
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "^5.0.1",
    "sass": "^1.66.1"
  },
  "devDependencies": {
    "gh-pages": "^4.0.0"
  },
  "scripts": {
    "start": "react-scripts start",
    "prebuild": "node scripts/check-facts.mjs",
    "build": "GENERATE_SOURCEMAP=false react-scripts build",
    "predeploy": "npm run build",
    "deploy": "node scripts/check-cname.mjs && gh-pages -d build",
    "check:facts": "node scripts/check-facts.mjs",
    "test": "react-scripts test"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.3%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
